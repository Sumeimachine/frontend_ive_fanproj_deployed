  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled pink action used to explore the site.",
      "html": "<a class=\"ds-primary\" href=\"/photo-gallery\">Explore the photographs <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-primary{font-family:Manrope,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:space-between;gap:30px;min-height:52px;padding:16px 22px;background:#ef9cc2;color:#151017;border:1px solid #ef9cc2;border-radius:3px;font-size:12px;font-weight:800;text-decoration:none;transition:background 180ms ease,transform 180ms ease}.ds-primary:hover{background:#f5bad7}.ds-primary:active{transform:scale(.98)}.ds-primary:focus-visible{outline:2px solid #ef9cc2;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Desktop navigation",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Quiet links with a pink active underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example site navigation\"><a href=\"/\">Home</a><a href=\"/photo-gallery\" aria-current=\"page\">Photo Gallery</a></nav>",
      "css": ".ds-nav{font-family:Manrope,system-ui,sans-serif;display:flex;gap:28px;height:88px;background:#0a0a0e;border-bottom:1px solid rgba(255,255,255,.14);padding:0 20px}.ds-nav a{position:relative;display:inline-flex;align-items:center;color:#b5afb8;font-size:12px;font-weight:500;text-decoration:none;transition:color 160ms ease}.ds-nav a::after{content:\"\";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:#ef9cc2;transform:scaleX(0);transform-origin:left;transition:transform 180ms cubic-bezier(.23,1,.32,1)}.ds-nav a[aria-current]{color:#f6f3f5}.ds-nav a[aria-current]::after{transform:scaleX(1)}.ds-nav a:hover{color:#f6f3f5}.ds-nav a:focus-visible{outline:2px solid #ef9cc2;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-nav a,.ds-nav a::after{transition:none}}"
    },
    {
      "name": "Photo filters",
      "kind": "chip",
      "refersTo": "photo-filter-selected",
      "description": "Member filters use a pink selected state and 44px targets; this snippet previews the states.",
      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Example member filters\"><button type=\"button\" aria-pressed=\"true\">All photos</button><button type=\"button\" aria-pressed=\"false\">Yujin</button><button type=\"button\" aria-pressed=\"false\">Gaeul</button></div>",
      "css": ".ds-filters{display:flex;flex-wrap:wrap;gap:6px}.ds-filters button{font-family:Manrope,system-ui,sans-serif;min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:3px;background:transparent;color:#b5afb8;font-size:12px;font-weight:600;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,transform 160ms ease}.ds-filters button[aria-pressed=\"true\"]{background:#ef9cc2;color:#191018}.ds-filters button:hover:not([aria-pressed=\"true\"]){background:#ffffff0d;color:#f6f3f5}.ds-filters button:active{transform:scale(.97)}.ds-filters button:focus-visible{outline:2px solid #ef9cc2;outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-filters button{transition:none}}"
    },
    {
      "name": "Community destination",
      "kind": "card",
      "description": "A spacious text row with a fine rule, taken from the home experience list.",
      "html": "<a class=\"ds-experience\" href=\"/photo-gallery\"><h3>Photo gallery</h3><p>IVE moments through a fellow DIVE’s lens.</p><span>Explore <svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></span></a>",
      "css": ".ds-experience{font-family:Manrope,system-ui,sans-serif;display:grid;grid-template-columns:1fr 1fr auto;align-items:center;gap:24px;padding:32px 0;border-block:1px solid rgba(246,243,245,.16);background:#0a0a0e;color:#f6f3f5;text-decoration:none;transition:background 220ms ease}.ds-experience h3{margin:0;font-family:Oswald,sans-serif;font-size:clamp(23px,2.4vw,36px);font-weight:500;line-height:1.3}.ds-experience p{margin:0;color:#b5afb8;font-size:12px;line-height:1.8}.ds-experience>span{display:flex;align-items:center;gap:20px;font-size:11px;color:#ef9cc2}.ds-experience:hover{background:#131116}.ds-experience:focus-visible{outline:2px solid #ef9cc2;outline-offset:5px}@media(max-width:600px){.ds-experience{grid-template-columns:1fr;gap:12px;padding:27px 0}}@media(prefers-reduced-motion:reduce){.ds-experience{transition:none}}"
    },
    {
      "name": "Photographer credit note",
      "kind": "custom",
      "description": "Visible attribution and permission context accompanying the photo archive.",
      "html": "<div class=\"ds-credit\"><span aria-hidden=\"true\">©</span><p>CTTO: all photos in this journal belong to GrantSor and are shared with permission for this non-commercial fan project. Original watermarks are preserved.</p><a href=\"https://x.com/GrantSor\" target=\"_blank\" rel=\"noopener noreferrer\">Visit @GrantSor ↗</a></div>",
      "css": ".ds-credit{font-family:Manrope,system-ui,sans-serif;display:flex;align-items:center;flex-wrap:wrap;gap:24px;padding:28px 0;border-block:1px solid #ffffff24;background:#0a0a0e}.ds-credit>span{color:#ef9cc2;font-size:32px;font-weight:300}.ds-credit p{flex:1;min-width:180px;max-width:760px;margin:0;color:#b5afb8;font-size:12px;line-height:1.85}.ds-credit a{color:#ef9cc2;font-size:12px;font-weight:600;text-decoration:underline;text-underline-offset:4px}.ds-credit a:hover{color:#fff}.ds-credit a:focus-visible{outline:2px solid #ef9cc2;outline-offset:5px}"
    }
